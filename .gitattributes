# ============================================================
# AMHARC repository text policy
#
# Canonical repository representation:
#   - text files use LF
#   - Windows batch files use CRLF
#   - binary files are never line-ending normalised
# ============================================================

* text=auto eol=lf

# Source
*.cs       text eol=lf
*.csproj   text eol=lf
*.props    text eol=lf
*.targets  text eol=lf
*.sln      text eol=lf

# Web / TypeScript / JavaScript
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.css      text eol=lf
*.scss     text eol=lf
*.html     text eol=lf

# Configuration / structured text
*.json     text eol=lf
*.jsonc    text eol=lf
*.xml      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.config   text eol=lf
*.env      text eol=lf

# Scripts
*.ps1      text eol=lf
*.psm1     text eol=lf
*.psd1     text eol=lf
*.sh       text eol=lf

# Native Windows command scripts retain CRLF.
*.bat      text eol=crlf
*.cmd      text eol=crlf

# Documentation / miscellaneous text
*.md       text eol=lf
*.txt      text eol=lf
*.csv      text eol=lf

# Images / archives / compiled assets
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.bmp      binary
*.pdf      binary
*.zip      binary
*.7z       binary
*.gz       binary
*.tar      binary
*.dll      binary
*.exe      binary
*.pdb      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.otf      binary
